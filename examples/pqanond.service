# systemd unit for a PQ-ANON VPN server. pqanond is configured by flags (it
# reads no config file); these are the ones a production server needs.
#
#   apt install nftables conntrack        # --nat needs both
#   install -m 0755 target/release/pqanond /usr/local/bin/
#   install -m 0644 examples/pqanond.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pqanond
#   pqanond --identity /var/lib/pqanon/pqanond.id --print-public   # the pins clients need
#
# Replace eth0 with the server's internet-facing interface. To admit enrolled
# devices only, add the control plane's keys:
#   --device-ca <device_ca_pub> --crl-url https://cp.example.com/api/crl --crl-pub <crl_pub>
#
# pqanond logs nothing about clients: no IP address, identity, device, tunnel
# address or session line, at any log level, and there is no option to turn
# that on (docs/log-schema.md). Every log line also passes through an address
# redactor. Activity is visible only as aggregate counters on --metrics, which
# stays on localhost here.

[Unit]
Description=PQ-ANON VPN server (pqanond)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pqanond \
    --identity /var/lib/pqanon/pqanond.id \
    --listen 0.0.0.0:443 \
    --tun pqanon0 --tun-addr 10.77.0.1/24 \
    --nat eth0 \
    --metrics 127.0.0.1:9100
# SIGTERM: every client is sent Close (they reconnect at once), then the NAT
# rules are removed.
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2

StateDirectory=pqanon
StateDirectoryMode=0700
# TUN, routes and nftables need CAP_NET_ADMIN; binding :443 needs
# CAP_NET_BIND_SERVICE. Nothing else.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
DynamicUser=yes
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
