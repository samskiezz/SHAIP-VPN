<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged with the build-generated keys (GENERATE_INFOPLIST_FILE = YES; see project.yml).
       Keys here have no INFOPLIST_KEY_ build-setting equivalent. -->
  <key>NSSupportsLiveActivities</key>
  <true/>
  <!-- Let animations (the 3-D scenes) run above 60 Hz on ProMotion iPhones. -->
  <key>CADisableMinimumFrameDurationOnPhone</key>
  <true/>
</dict>
</plist>
